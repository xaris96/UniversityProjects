            "source": [
                "%matplotlib inline",
                "import pandas as pd",
                "import matplotlib.pyplot as plt",
                "from src.plot_doughnut import plot_doughnut_area_scaled",
                "",
                "# Example data for demonstration",
                "data = {",
                "    'domain': ['social', 'social', 'ecological', 'ecological'],",
                "    'indicator': ['Adequate Housing', 'Access to Energy', 'Climate Change', 'Ocean Acidification'],",
                "    'ratio_pct': [30, 50, 70, 90],",
                "    'color': ['#ffc6c4', '#ffc6c4', '#672044', '#672044']",
                "}",
                "df = pd.DataFrame(data)",
                "",
                "# Define mapping for labels",
                "map_social = {",
                "    'Adequate Housing': 'Adequate Housing',",
                "    'Access to Energy': 'Access to Energy'",
                "}",
                "",
                "map_ecological = {",
                "    'Climate Change': 'Climate Change',",
                "    'Ocean Acidification': 'Ocean Acidification'",
                "}",
                "",
                "# Plotting the doughnut chart",
                "try:",
                "    fig, ax = plot_doughnut_area_scaled(",
                "        df_dn=df,",
                "        inner_domain='social',",
                "        outer_domain='ecological',",
                "        map_social=map_social,",
                "        map_ecological=map_ecological,",
                "        figsize=(10, 10),",
                "        title='Doughnut Chart Example'",
                "    )",
                "    plt.show()",
                "except FileNotFoundError as e:",
                "    print(f\"Error: Data file not found. {e}\")",
                "except RuntimeError as e:",
                "    print(f\"Error processing data: {e}\")",
                "except Exception as e:",
                "    print(f\"General Error: {e}\")"
            ]
        }
    ]
}